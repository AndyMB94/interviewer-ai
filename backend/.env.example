# Django SECRET_KEY -- obligatorio en producción, dejar vacío solo usa el valor
# inseguro de desarrollo hardcodeado en settings.py. Generar uno nuevo para producción:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# LLM: DeepSeek (https://platform.deepseek.com) — SDK compatible con openai
DEEPSEEK_API_KEY=

# Postgres (ver docker-compose.yml en la raíz — deben coincidir esos valores)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Redis (ver docker-compose.yml en la raíz) — broker y result backend de Celery
REDIS_URL=

# STT: Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# TTS: ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Email transaccional: Resend (https://resend.com/api-keys) — ver docs/Email/Resend/
RESEND_API_KEY=