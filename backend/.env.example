# True en local/dev, False (o directamente sin setear) en producción -- nunca True en producción,
# expone stack traces y config completa en cualquier error 500.
DEBUG=True

# Django SECRET_KEY -- obligatorio, la app no arranca sin esto (Infra Fase 6, sin valor de
# respaldo a propósito). Generar uno nuevo:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Secreto compartido con el ws-gateway (Infra Fase 7) -- obligatorio, mismo criterio que
# SECRET_KEY. El MISMO valor va acá y en el .env de la raíz del proyecto (lo usa docker-compose.yml
# para inyectárselo al gateway) -- si no coinciden, el gateway no puede hablar con el backend.
# Generar uno nuevo: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_SHARED_SECRET=

# LLM: DeepSeek (https://platform.deepseek.com) — SDK compatible con openai
DEEPSEEK_API_KEY=

# Postgres (ver docker-compose.yml en la raíz — deben coincidir esos valores)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Redis (ver docker-compose.yml en la raíz) — broker y result backend de Celery
REDIS_URL=

# STT: Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# TTS: ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Email transaccional: Resend (https://resend.com/api-keys) — ver docs/Email/Resend/
RESEND_API_KEY=